--
-- Estructura para la vista `inf_actuadores`
--
DROP TABLE IF EXISTS `inf_actuadores`;

CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `inf_actuadores`  AS SELECT `a`.`id_actuador` AS `id_actuador`, `a`.`tipo_actuador` AS `tipo_actuador`, `a`.`ubicacion` AS `ubicacion`, `a`.`fecha_instalacion` AS `fecha_instalacion`, `a`.`estado` AS `estado`, `e`.`id_evento` AS `id_evento`, `e`.`accion` AS `accion`, `e`.`fecha_hora` AS `fecha_hora` FROM (`actuadores` `a` join `eventos_actuadores` `e` on(`a`.`id_actuador` = `e`.`id_actuador`)) ;

