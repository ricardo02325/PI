DROP TABLE IF EXISTS `conf_sistema`;

CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `conf_sistema`  AS SELECT `configuracion_sistema`.`id_configuracion` AS `id_configuracion`, `configuracion_sistema`.`parametro` AS `parametro`, `configuracion_sistema`.`valor` AS `valor`, `configuracion_sistema`.`fecha_actualizacion` AS `fecha_actualizacion` FROM `configuracion_sistema` ;

