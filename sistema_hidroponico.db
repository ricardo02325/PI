DROP TABLE IF EXISTS `inf_sensores`;

CREATE ALGORITHM=UNDEFINED DEFINER=`root`@`localhost` SQL SECURITY DEFINER VIEW `inf_sensores`  AS SELECT `sensores`.`id_sensor` AS `id_sensor`, `sensores`.`tipo_sensor` AS `tipo_sensor`, `sensores`.`estado` AS `estado`, `lecturas_sensores`.`id_lectura` AS `id_lectura`, `lecturas_sensores`.`valor` AS `valor`, `lecturas_sensores`.`fecha_hora` AS `fecha_hora` FROM (`sensores` join `lecturas_sensores` on(`sensores`.`id_sensor` = `lecturas_sensores`.`id_sensor`)) ;

